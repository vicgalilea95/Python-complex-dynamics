Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", "=", "2"}], ";", 
  RowBox[{"iter2", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"z", ",", "_Complex"}], "}"}], "}"}], ",", 
     FractionBox[
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "m"}], ")"}], " ", "z"}], "+", 
       RowBox[{"m", " ", 
        SuperscriptBox["z", "2"]}]}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", "m", "+", "z", "+", 
       RowBox[{"m", " ", "z"}]}]]}], "]"}]}], ";", 
  RowBox[{"aproxpfijo", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"z", ",", "_Complex"}], "}"}], "}"}], ",", " ", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"z", "-", "1"}], "]"}], "<", 
        RowBox[{"10.0", "^", 
         RowBox[{"(", 
          RowBox[{"-", "6"}], ")"}]}]}], ",", " ", "2", ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"z", "+", "1"}], "]"}], "<", 
        RowBox[{"10.0", "^", 
         RowBox[{"(", 
          RowBox[{"-", "6"}], ")"}]}]}], ",", " ", "1", ",", 
       "\[IndentingNewLine]", "True", ",", " ", "0"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"iterAlgorithm", "[", 
    RowBox[{"iterMethod_", ",", " ", "x_", ",", " ", "y_", ",", " ", "lim_"}],
     "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", ",", "ct", ",", "r"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"z", "=", 
       RowBox[{"x", "+", 
        RowBox[{"I", "*", "y"}]}]}], ";", 
      RowBox[{"ct", "=", "0"}], ";", " ", 
      RowBox[{"r", "=", 
       RowBox[{"aproxpfijo", "[", "z", "]"}]}], ";", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", "\[Equal]", "0"}], ")"}], " ", "&&", " ", 
         RowBox[{"(", 
          RowBox[{"ct", " ", "<", " ", "lim"}], ")"}]}], ",", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{
         RowBox[{"++", "ct"}], ";", " ", 
         RowBox[{"z", "=", 
          RowBox[{"iterMethod", "[", "z", "]"}]}], ";", " ", 
         RowBox[{"r", "=", 
          RowBox[{"aproxpfijo", "[", "z", "]"}]}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "r", "]"}], "\[Equal]", "Which"}], ",", " ", 
        RowBox[{"r", "=", "0"}]}], "]"}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"\"\<Which\>\"", " ", "unevaluated"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "r", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"limIterations", "=", "50"}], ";", " ", 
  RowBox[{"xxMin", "=", 
   RowBox[{"-", "3"}]}], ";", " ", 
  RowBox[{"xxMax", "=", "1"}], ";", " ", 
  RowBox[{"yyMin", "=", 
   RowBox[{"-", "2.5"}]}], ";", 
  RowBox[{"yyMax", "=", "2.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotFractal", "[", 
    RowBox[{"iterMethod_", ",", "points_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"DensityPlot", "[", 
     RowBox[{
      RowBox[{"iterAlgorithm", "[", 
       RowBox[{
       "iterMethod", ",", "x", ",", " ", "y", ",", " ", "limIterations"}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "xxMin", ",", " ", "xxMax"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"y", ",", "yyMin", ",", "yyMax"}], "}"}], ",", " ", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"0", ",", "2"}], "}"}]}], ",", " ", 
      RowBox[{"PlotPoints", "\[Rule]", "points"}], ",", " ", 
      RowBox[{"Mesh", "\[Rule]", "False"}], ",", 
      RowBox[{"ColorFunction", "->", "GrayLevel"}]}], "\[IndentingNewLine]", 
     "]"}], "//", "Timing"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dibu2", "=", 
   RowBox[{"plotFractal", "[", 
    RowBox[{"iter2", ",", " ", "128"}], "]"}]}], ";", 
  RowBox[{"dibu1", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{"recta", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "3"}], ",", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "3"}]}], "}"}]}], "]"}]}], ";", 
  RowBox[{"Show", "[", " ", 
   RowBox[{
    RowBox[{"dibu2", "[", 
     RowBox[{"[", "2", "]"}], "]"}], ",", "dibu1"}], "]"}]}]}], "Input",
