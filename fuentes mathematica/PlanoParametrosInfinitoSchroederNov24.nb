Cell[CellGroupData[{

Cell["Iterative algorithm and color fractals (sin Timing)", "Subsection",
 CellChangeTimes->{{3.644158737811331*^9, 
  3.644158741613864*^9}},ExpressionUUID->"96e75a79-eb67-4ba4-9001-\
8cfff137d289"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{
  "iterColorAlgorithm", ",", "colorLevel", ",", "fractalColor", ",", 
   "plotColorFractal"}], "]"}]], "Input",
 CellLabel->
  "In[148]:=",ExpressionUUID->"ebb10bf4-3fcc-4734-a97e-1c538833d3bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"iterColorAlgorithm", "[", 
   RowBox[{"iterMethod_", ",", "x_", ",", "y_", ",", "lim_"}], "]"}], " ", ":=",
   "\n", "    ", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"z", ",", "\[Lambda]", ",", "ct", ",", "r"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"z", " ", "=", "0."}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Lambda]", "=", " ", 
      RowBox[{"x", " ", "+", " ", 
       RowBox[{"y", " ", "I"}]}]}], ";", " ", 
     RowBox[{"ct", " ", "=", " ", "0"}], ";", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"rootPosition", "[", "z", "]"}]}], ";", "\n", "        ", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"r", "==", "0"}], ")"}], " ", "&&", " ", 
        RowBox[{"(", 
         RowBox[{"ct", " ", "<", " ", "lim"}], ")"}]}], ",", "\n", 
       "            ", 
       RowBox[{
        RowBox[{"++", "ct"}], ";", " ", 
        RowBox[{"z", " ", "=", " ", 
         RowBox[{"iterMethod", "[", 
          RowBox[{"z", ",", "\[Lambda]"}], "]"}]}], ";", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"rootPosition", "[", "z", "]"}]}]}]}], "\n", "\t       ", 
      "]"}], ";", "\n", "\t\t    ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "r", "]"}], "==", "Which"}], ",", 
       RowBox[{"r", " ", "=", "0"}]}], "]"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"\"\<Which\>\"", " ", "unevaluated", " ", 
       RowBox[{"Return", "[", 
        RowBox[{"N", "[", 
         RowBox[{"r", "+", 
          RowBox[{"ct", "/", 
           RowBox[{"(", 
            RowBox[{"lim", "+", "0.001"}], ")"}]}]}], "]"}], "]"}]}], " ", 
      "*)"}], "\n", "\t       ", 
     RowBox[{"Return", "[", 
      RowBox[{"N", "[", "r", "]"}], "]"}]}]}], "\n", "    ", "]"}]}]], "Input",\

 CellChangeTimes->{{3.6084900180430403`*^9, 3.6084900273452272`*^9}, 
