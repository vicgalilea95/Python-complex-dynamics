Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"p", "[", "z_", "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"z", "^", "2"}], "-", "1"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"z", "-", "\[Lambda]"}], ")"}]}]}], ";", " ", 
  RowBox[{
   RowBox[{"Lp", "[", "z_", "]"}], "=", 
   RowBox[{
    RowBox[{"p", "[", "z", "]"}], 
    RowBox[{
     RowBox[{
      RowBox[{"p", "''"}], "[", "z", "]"}], "/", 
     RowBox[{
      RowBox[{
       RowBox[{"p", "'"}], "[", "z", "]"}], "^", "2"}]}]}]}], ";", 
  RowBox[{
   RowBox[{"S", "[", "z_", "]"}], "=", 
   RowBox[{
    RowBox[{"z", "-", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Lp", "[", "z", "]"}]}], ")"}]}], 
      RowBox[{
       RowBox[{"p", "[", "z", "]"}], "/", 
       RowBox[{
        RowBox[{"p", "'"}], "[", "z", "]"}]}]}]}], "//", "Simplify", 
    " "}]}]}]], "Input",
 CellChangeTimes->{{3.7410722533587713`*^9, 3.741072260467683*^9}, 
